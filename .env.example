# Contact form — required in each deployment environment (there is no fallback sender)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=verified_sender@example.com

# Contact form — optional; defaults to the public contact address
CONTACT_EMAIL=your_contact_inbox@example.com

# Optional build-time GTM container. Leave unset: index.html already loads GTM-NJZ5ZBX4,
# and GTMProvider injects a second container only when this names a different one.
# VITE_GTM_ID=GTM-XXXXXXX
